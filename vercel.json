{
  "version": 2,
  "functions": {
    "api/*.py": {
      "includeFiles": ["api/firestore.py"]
    }
  },
  "rewrites": [
    {
      "source": "/api/data",
      "destination": "/api/data.py"
    },
    {
      "source": "/api/save",
      "destination": "/api/save.py"
    },
    {
      "source": "/api/visits",
      "destination": "/api/visits.py"
    }
  ]
}
